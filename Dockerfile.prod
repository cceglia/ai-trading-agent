FROM ubuntu:26.04 AS base

# Install system dependencies, Node.js, Python 3
RUN apt-get update && apt-get install -y \
    nodejs npm python3 python3-dev python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- Create virtual environment ----
RUN python3 -m venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# ---- Create non-root user with configurable UID/GID ----
# Removes any existing user/group that conflicts with the target IDs
ARG USER_ID=1000
ARG GROUP_ID=1000
COPY scripts/create-user.sh /tmp/
RUN USER_ID=${USER_ID} GROUP_ID=${GROUP_ID} /tmp/create-user.sh && \
    rm /tmp/create-user.sh

# Switch to non-root user for everything below
USER app

# ---- Layer 1: Dependencies (cached until package files change) ----

# Server dependencies (Python FastAPI)
COPY --chown=app:app server/pyproject.toml ./server/
RUN cd server && pip install --no-cache-dir "."

# Analyzer dependencies (install into venv)
COPY --chown=app:app analyzer/pyproject.toml ./analyzer/
RUN cd analyzer && pip install --no-cache-dir "."

# UI dependencies
COPY --chown=app:app ui/package*.json ./ui/
RUN cd ui && npm ci

# ---- Layer 2: Source code ----

COPY --chown=app:app . .

# ---- Layer 3: Build artifacts ----

# Build the UI (still requires Node.js)
RUN cd ui && npm run build

EXPOSE 3000

# server/src/ uses absolute imports like `from src.models import ...`
# which need /app/server on PYTHONPATH to resolve.
ENV PYTHONPATH="/app/server:$PYTHONPATH"

CMD ["uvicorn", "server.src.main:app", "--host", "0.0.0.0", "--port", "3000"]
