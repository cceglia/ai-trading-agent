FROM ubuntu:26.04

# Install system dependencies, Node.js, Python 3
RUN apt-get update && apt-get install -y \
    nodejs npm python3 python3-dev python3-pip python3-venv \
    && npm install -g tsx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create virtual environment and auto-activate on shell login
RUN python3 -m venv /app/.venv && \
    echo "source /app/.venv/bin/activate" >> /root/.bashrc

# Make venv binaries available in PATH (so python/pip resolve to venv)
ENV PATH="/app/.venv/bin:$PATH"

# Container stays alive — you run commands via docker exec
CMD ["sleep", "infinity"]
