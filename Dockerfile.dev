FROM ubuntu:26.04

# Install system dependencies, Node.js, Python 3 (as root)
RUN apt-get update && apt-get install -y \
    nodejs npm python3 python3-dev python3-pip python3-venv \
    && npm install -g tsx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create non-root user with configurable UID/GID
# Removes any existing user/group that conflicts with the target IDs
ARG USER_ID=1000
ARG GROUP_ID=1000
COPY scripts/create-user.sh /tmp/
RUN USER_ID=${USER_ID} GROUP_ID=${GROUP_ID} /tmp/create-user.sh && \
    rm /tmp/create-user.sh

# Switch to non-root user for everything below
USER app

# Create virtual environment and auto-activate on shell login
RUN python3 -m venv /app/.venv && \
    echo "source /app/.venv/bin/activate" >> /home/app/.bashrc

# Make venv binaries available in PATH (so python/pip resolve to venv)
ENV PATH="/app/.venv/bin:$PATH"

# Container stays alive — you run commands via docker exec
CMD ["sleep", "infinity"]
