FROM ubuntu:26.04

# Install system dependencies, Node.js, Python 3 (as root)
RUN apt-get update && apt-get install -y \
    nodejs npm python3 python3-dev python3-pip python3-venv \
    && npm install -g tsx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create non-root user with configurable UID/GID
# Removes any existing user/group that conflicts with the target IDs
ARG USER_ID=1000
ARG GROUP_ID=1000
COPY scripts/create-user.sh /tmp/
RUN USER_ID=${USER_ID} GROUP_ID=${GROUP_ID} /tmp/create-user.sh && \
    rm /tmp/create-user.sh

# Copy and fix permissions for the startup script (while still root)
COPY scripts/start-dev.sh /app/scripts/start-dev.sh
RUN chmod +x /app/scripts/start-dev.sh

# Create virtual environment and install Python dependencies (as root,
# because pip install -e writes egg-info into the source directory).
RUN python3 -m venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

COPY server/pyproject.toml /app/server/pyproject.toml
COPY analyzer/pyproject.toml /app/analyzer/pyproject.toml
RUN pip install -e /app/server -e /app/analyzer

# Install UI frontend dependencies (as root)
COPY ui/package.json ui/package-lock.json* /app/ui/
RUN cd /app/ui && npm ci

# Make venv owned by app user so it can be activated at runtime
RUN chown -R app:app /app/.venv

# Switch to non-root user for runtime
USER app

# Launch both FastAPI (reload) and Vite dev server (HMR) on startup
CMD ["/app/scripts/start-dev.sh"]
