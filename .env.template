# ============================================================
# Trading Agent — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and adjust the values.
# Every variable here is optional: empty values fall back to the
# defaults defined in analyzer/config/settings.py (prefix TRADING_)
# and server/src/settings.py (server variables).

# ------------------------------------------------------------
# Execution Mode
# ------------------------------------------------------------
# Valid values: DETERMINISTIC_BACKTEST, FULL_CHAIN_BACKTEST,
#               DEVELOPMENT, SHADOW, PAPER, LIVE
# PAPER/LIVE enforce a strict review policy (see "Review Policy").
TRADING_EXECUTION_MODE=PAPER

# ------------------------------------------------------------
# Terminal (MT5 data source)
# ------------------------------------------------------------
# MCP server URL providing candle data and positions.
TRADING_TERMINAL_SERVER_URL=http://127.0.0.1:22346/mcp
# Bearer token for terminal MCP server authentication.
TRADING_TERMINAL_API_KEY=your-terminal-api-key-here

# ------------------------------------------------------------
# LLM — Primary (Synthesizer + Decider)
# ------------------------------------------------------------
# Provider for the primary LLM (currently only "openai" is supported).
TRADING_PRIMARY_LLM_PROVIDER=openai
# OpenAI API key (or compatible provider).
TRADING_OPENAI_API_KEY=your-api-key-here
# Model identifier.
TRADING_OPENAI_MODEL=gpt-4o
# OpenAI-compatible base URL (optional).
# Examples: http://localhost:11434/v1 (Ollama), https://api.groq.com/openai/v1
# Leave empty to use https://api.openai.com/v1 (default).
TRADING_OPENAI_BASE_URL=
# Temperature: float 0.0–2.0. 0.0 = deterministic, higher = more creative.
TRADING_OPENAI_TEMPERATURE=0.0
# reasoning_effort: low, medium, high. Empty = model default.
TRADING_OPENAI_REASONING_EFFORT=
# Override detected model family/version (optional).
TRADING_OPENAI_MODEL_FAMILY_OVERRIDE=
TRADING_OPENAI_MODEL_VERSION_OVERRIDE=

# ------------------------------------------------------------
# LLM — Reviewer (independent)
# ------------------------------------------------------------
# Provider for the reviewer LLM (currently only "openai" is supported).
TRADING_REVIEWER_LLM_PROVIDER=openai
# Model identifier. Empty = use primary model.
TRADING_REVIEWER_MODEL=
# Override detected model family/version (optional).
TRADING_REVIEWER_MODEL_FAMILY_OVERRIDE=
TRADING_REVIEWER_MODEL_VERSION_OVERRIDE=
# API key. Empty = use primary API key.
TRADING_REVIEWER_API_KEY=
# Base URL. Empty = default for the provider.
TRADING_REVIEWER_BASE_URL=
# Reviewer-specific call settings.
TRADING_REVIEWER_TEMPERATURE=0.0
TRADING_REVIEWER_REASONING_EFFORT=

# ------------------------------------------------------------
# Review Policy
# ------------------------------------------------------------
# Require an independent reviewer for executable decisions.
TRADING_REQUIRE_REVIEWER=true
# Allow decisions without review (forbidden in paper/live mode).
TRADING_ALLOW_UNREVIEWED_DECISIONS=false
# Allow reviewer to use the same model family with a different deployment.
TRADING_ALLOW_SAME_MODEL_DIFFERENT_DEPLOYMENT=false
# Maximum review retry attempts per symbol.
TRADING_MAX_REVIEW_ATTEMPTS=2

# ------------------------------------------------------------
# Setup Policy
# ------------------------------------------------------------
# Allow countertrend setups.
TRADING_ENABLE_COUNTERTREND=false

# R/R thresholds
TRADING_MIN_RR_AAA=2.0
TRADING_MIN_RR_AA=2.0
TRADING_MIN_RR_COUNTERTREND=2.5

# Risk multipliers
TRADING_RISK_MULTIPLIER_AAA=1.0
TRADING_RISK_MULTIPLIER_AA=0.5
TRADING_RISK_MULTIPLIER_COUNTERTREND=0.25

# Setup lifecycle
TRADING_SETUP_EXPIRATION_H1_BARS=3

# ------------------------------------------------------------
# Cost
# ------------------------------------------------------------
# Maximum allowed LLM cost per symbol (USD).
TRADING_COST_PER_SYMBOL_LIMIT=0.05

# Model pricing (JSON — overrides the built-in defaults).
# TRADING_MODEL_PRICING='{"gpt-4o": {"input_per_million": 2.5, "cached_input_per_million": 1.25, "output_per_million": 10.0}}'

# ------------------------------------------------------------
# Calendar
# ------------------------------------------------------------
# Hours to cache ForexFactory calendar events.
TRADING_CALENDAR_CACHE_HOURS=4

# ------------------------------------------------------------
# Candle Cache & Closing Times
# ------------------------------------------------------------
# D1 candle close time (HH:MM in broker time).
TRADING_D1_CLOSE_TIME=00:00
# H4 anchor time (HH:MM in broker time).
TRADING_H4_CLOSE_TIME=00:00
# H4 interval in hours.
TRADING_H4_CLOSE_INTERVAL_HOURS=4

# ------------------------------------------------------------
# Data & Caching
# ------------------------------------------------------------
# Base directory for analysis cache and run results.
# (Docker: /app/data; native: relative to project root, or absolute.)
TRADING_ANALYSIS_CACHE_DIR=data
# Enable synthesizer output caching (content-addressable).
TRADING_SYNTHESIZER_CACHE_ENABLED=true

# ------------------------------------------------------------
# Telegram Notifications (optional)
# ------------------------------------------------------------
TRADING_TELEGRAM_BOT_TOKEN=
TRADING_TELEGRAM_CHAT_ID=
# Web UI base URL used in notification links.
TRADING_WEB_UI_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
TRADING_LOG_LEVEL=INFO

# ------------------------------------------------------------
# Server (FastAPI web API)
# ------------------------------------------------------------
# HTTP listen address.
HOST=0.0.0.0
# HTTP listen port.
PORT=3000
# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:5173
# Python executable used to spawn the analyzer subprocess.
PYTHON_CMD=python
# API key required on the X-API-Key header. Empty = auth disabled.
TRADING_API_KEY=
# Rate limiting.
TRADING_RATE_LIMIT_MAX=20
TRADING_RATE_LIMIT_WINDOW=60

# ------------------------------------------------------------
# Docker (host user mapping)
# ------------------------------------------------------------
# Match host UID:GID to avoid root-owned files in bind mounts.
# Run `id -u` and `id -g` to find your values.
UID=1000
GID=1000
