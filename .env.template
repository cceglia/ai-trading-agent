# Terminal MCP Server
TRADING_TERMINAL_SERVER_URL=http://127.0.0.1:22346/mcp
TRADING_TERMINAL_API_KEY=your-terminal-api-key-here

# OpenAI
TRADING_OPENAI_API_KEY=your-api-key-here
TRADING_OPENAI_MODEL=gpt-4o

# OpenAI-compatible base URL (optional)
# Examples: http://localhost:11434/v1 (Ollama), https://api.groq.com/openai/v1
# Leave empty to use https://api.openai.com/v1 (default)
TRADING_OPENAI_BASE_URL=

# Review
TRADING_MAX_REVIEW_ATTEMPTS=2

# Cost
TRADING_COST_PER_SYMBOL_LIMIT=0.05

# Calendar
TRADING_CALENDAR_CACHE_HOURS=4

# Logging
TRADING_LOG_LEVEL=INFO
